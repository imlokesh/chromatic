  "components": [
    {
      "name": "Label filter",
      "kind": "custom",
      "description": "One control from the implemented filter, group, and sort bar; stacks its label above the select in compact mode.",
      "html": "<label class=\"ds-view-control\">Filter label<select class=\"ds-view-select\"><option>All labels</option><option>testing</option></select></label>",
      "css": ".ds-view-control{display:flex;align-items:center;gap:8px;font:400 12px/1.5 Segoe UI,sans-serif;color:var(--ink,#292933)}.ds-view-select{padding:7px;border:1px solid var(--line,#e4e2df);border-radius:7px;background:var(--surface,#fff);color:var(--ink,#292933);font:400 12px/1.5 Segoe UI,sans-serif}.ds-view-select:hover{border-color:var(--line,#e4e2df)}.ds-view-select:focus-visible{outline:2px solid var(--accent,#6853aa);outline-offset:3px}@media(max-width:1020px){.ds-view-control{flex-direction:column;align-items:stretch}}"
    },
    {
      "name": "Storage row",
      "kind": "custom",
      "description": "Profile name and scan time, total size including cache, estimated disposable cache, and explicit cleanup review.",
      "html": "<div class=\"ds-storage-row\"><div><strong class=\"ds-storage-name\">Work</strong><small class=\"ds-storage-time\">Scanned 11:19 PM</small></div><span>24 MB</span><span>3 MB</span><button class=\"ds-storage-action\">Review cleanup</button></div>",
      "css": ".ds-storage-row{display:grid;grid-template-columns:minmax(100px,1fr) 95px 105px 120px;gap:15px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line,#e4e2df);color:var(--ink,#292933);font:400 12px/1.5 Segoe UI,sans-serif}.ds-storage-name{font-size:14px;font-weight:600}.ds-storage-time{display:block;color:var(--muted,#72717b);font-size:11px}.ds-storage-action{padding:7px;border:0;background:transparent;color:var(--accent,#6853aa);font:400 12px/1.5 Segoe UI,sans-serif;cursor:pointer}.ds-storage-action:hover{color:var(--accent,#6853aa)}.ds-storage-action:focus-visible{outline:2px solid var(--accent,#6853aa);outline-offset:3px}@media(max-width:1020px){.ds-storage-row{grid-template-columns:minmax(95px,1fr) 80px 90px 115px;gap:10px}}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Explicit task confirmation.",
      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary{font-family:Segoe UI,sans-serif;font-size:13px;font-weight:600;cursor:pointer;border-radius:7px;padding:10px 15px;border:0;background:var(--accent,#6853aa);color:var(--on-accent,#fff)}.ds-primary:hover{background:var(--accent-hover,#58458f)}.ds-primary:focus-visible{outline:2px solid var(--accent,#6853aa);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary button",
