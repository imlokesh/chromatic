      "css": ".ds-label{display:flex;flex-direction:column;gap:7px;font:600 12px/1.5 Segoe UI,sans-serif;color:var(--ink,#292933)}.ds-input{font:400 14px/1.5 Segoe UI,sans-serif;border:1px solid var(--line,#e4e2df);border-radius:7px;padding:10px 12px;background:var(--surface,#fff);color:var(--ink,#292933)}.ds-input:hover{border-color:var(--line,#e4e2df)}.ds-input:focus-visible{outline:2px solid var(--accent,#6853aa);outline-offset:3px;}"
