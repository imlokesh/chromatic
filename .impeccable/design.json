      "css": ".ds-secondary{font-family:Segoe UI,sans-serif;font-size:13px;font-weight:600;cursor:pointer;border-radius:7px;padding:10px 15px;border:1px solid var(--line,#e4e2df);background:var(--surface,#fff);color:var(--ink,#292933)}.ds-secondary:hover{background:var(--hover,#eae8e4)}.ds-secondary:focus-visible{outline:2px solid var(--accent,#6853aa);outline-offset:3px;}"
