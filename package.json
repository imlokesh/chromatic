{
  "name": "chromatic-launcher",
  "version": "0.2.3",
  "description": "A quiet home for every browser profile",
  "author": "Chromatic",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:app": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "check": "tsc --noEmit",
    "test:smoke": "npm run build && node scripts/smoke.cjs",
    "test:performance": "npm run build && node scripts/performance-smoke.cjs"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^0.468.0",
    "proxy-chain": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "app.chromatic.launcher",
    "productName": "Chromatic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "chromatic",
        "name": "Chromatic profile",
        "description": "Chromatic profile reference",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      }
    ]
  },
  "license": "UNLICENSED"
}
